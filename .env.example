# ===== ACA 2 · CardioGuía RAG · copie este archivo como .env y complete los valores =====
# NO suba el archivo .env a GitHub (está excluido en .gitignore)

# --- Base vectorial del ACA 1 (Qdrant Cloud > Clusters > API Keys) ---
QDRANT_URL=https://TU-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=PEGA_AQUI_TU_API_KEY
QDRANT_COLLECTION=salud_cardiaca_rag
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- LLM: gemini (cloud, recomendado) | groq (cloud) | ollama (local) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GEMINI     # https://aistudio.google.com/apikey
GROQ_API_KEY=                                     # https://console.groq.com/keys (opcional)
OLLAMA_BASE_URL=http://localhost:11434/v1         # solo si LLM_PROVIDER=ollama

# --- Hiperparámetros (justificados en el notebook, sección 3) ---
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.40
GEMINI_THINKING_LEVEL=low                         # razonamiento interno de Gemini 3 (low = menor latencia)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
